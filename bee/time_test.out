================================================================================
Test: to_string
Time() -> '1970-01-01 00:00:00'
Time() + Span::of_int_hours(400000) -> '2015-08-19 16:00:00'

================================================================================
Test: of_date
r(2023, 01, 30) -> '2023-01-30 00:00:00'
r(1970, 01, 01) -> '1970-01-01 00:00:00'
r(2000, 12, 31) -> '2000-12-31 00:00:00'
r(2000, 02, 29) -> '2000-02-29 00:00:00'
r(2000, 03, 01) -> '2000-03-01 00:00:00'
r(2001, 03, 01) -> '2001-03-01 00:00:00'
r(2001, 03, 01) + Span::of_float_hours(23.3412) -> '2001-03-01 23:20:28.32'

================================================================================
Test: of_string
Time::of_string("") -> 'Error(Invalid time format)'
Time::of_string("2000-01-01") -> 'Error(Invalid time format)'
Time::of_string("2000-01-01 12") -> 'Error(Invalid time format)'
Time::of_string("2000-01-01 12:02:03.56") -> '2000-01-01 12:02:03.56'
Time::of_string("2000-01-01 12:02:03.123456789") -> '2000-01-01 12:02:03.123456789'
Time::of_string("2023-09-20 23:58:43") -> '2023-09-20 23:58:43'

================================================================================
Test: to_string_localtime
Time::of_string("2000-01-01 12:02:03.123456789") .value() .to_string_localtime() -> '2000-01-01 07:02:03.123456789'

================================================================================
Test: to_string_decimals
2000-01-01 12:02:03.56 -> 2000-01-01 12:02:03.560000000
2000-01-01 12:02:03 -> 2000-01-01 12:02:03.000000000
2000-01-01 12:02:03.123456789 -> 2000-01-01 12:02:03.123456789

